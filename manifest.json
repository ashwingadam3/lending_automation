{
  "manifest_version": 3,
  "name": "LenDenClub Auto-Filter & Reload",
  "version": "1.0.5",
  "description": "Automates LenDenClub categories: re-loads last used filters & sort, applies them, and runs automatically every 31st minute in the background.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "*://app.lendenclub.com/*",
    "*://*.lendenclub.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LenDenClub Auto-Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://app.lendenclub.com/*",
        "*://*.lendenclub.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
